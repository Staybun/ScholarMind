# Copy to .env, then enter your DashScope API key. Never commit .env.
DASHSCOPE_API_KEY=
SCHOLARMIND_BIND_ADDRESS=127.0.0.1
SCHOLARMIND_PORT=9900
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0
# Endpoint must expose POST /v1/rerank and host BAAI/bge-reranker-v2-m3.
BGE_RERANK_BASE_URL=
BGE_RERANK_API_KEY=
BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
BGE_RERANK_TIMEOUT_MS=30000
